{
    "services-header": {
        "type": "header",
        "description": "Services"
    },
    "services": {
        "type": "list",
        "description": "Choose the systemd services to monitor",
        "columns": [
            {
                "id": "label",
                "title": "Display name",
                "type": "string"
            },
            {
                "id": "unit",
                "title": "Unit",
                "type": "string"
            },
            {
                "id": "user",
                "title": "User service",
                "type": "boolean",
                "default": false
            }
        ],
        "default": [
            {
                "label": "Minecraft Server",
                "unit": "minecraft-server.service",
                "user": true
            }
        ]
    },
    "refresh-interval": {
        "type": "spinbutton",
        "default": 5,
        "min": 2,
        "max": 300,
        "step": 1,
        "units": "seconds",
        "description": "Refresh interval"
    },
    "show-notifications": {
        "type": "switch",
        "default": true,
        "description": "Notify when a service fails or recovers"
    },
    "journal-lines": {
        "type": "spinbutton",
        "default": 1000,
        "min": 1,
        "max": 100000,
        "step": 100,
        "units": "lines",
        "description": "Journal history lines"
    },
    "appearance-header": {
        "type": "header",
        "description": "Appearance"
    },
    "background-color": {
        "type": "colorchooser",
        "default": "rgb(31,36,43)",
        "description": "Background color"
    },
    "background-transparency": {
        "type": "scale",
        "default": 0.08,
        "min": 0,
        "max": 1,
        "step": 0.05,
        "description": "Background transparency"
    },
    "text-size": {
        "type": "spinbutton",
        "default": 14,
        "min": 10,
        "max": 24,
        "step": 1,
        "units": "pixels",
        "description": "Text size"
    }
}
